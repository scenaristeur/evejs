    "distribus": "github:scenaristeur/distribus#develop",
    "hypertimer": "github:scenaristeur/hypertimer#develop",
    "promise": "^8.1.0",
    "pubnub": "^4.36.0",
    "seed-random": "^2.2.0",
    "uuid-v4": "^0.1.0",
    "ws": "^8.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.1.2",
    "babel-loader": "^8.0.4",
    "babelify": "^10.0.0",
    "browserify": "^17.0.0",
    "freeport": "^1.0.5",
    "gulp": "^4.0.2",
    "gulp-babel": "^8.0.0",
    "gulp-clean": "^0.4.0",
    "gulp-inline-sourcemap": "^0.1.1",
